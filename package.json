{
  "name": "commit-pack",
  "version": "1.1.0",
  "description": "A setup package to automatly check project's style and commit configuration",
  "main": "lib/index.js",
  "scripts": {
    "postinstall": "node bin/index.mjs",
    "lint": "eslint ./ --ext .ts,.tsx,.json --max-warnings=0",
    "format": "prettier --config .prettierrc '.' --write",
    "prepare": "husky",
    "commit": "cz",
    "build": "babel bin/index.mjs --out-file lib/index.mjs",
    "prepublishOnly": "npm run build",
    "release": "standard-version"
  },
  "bin": {
    "commit-pack-init": "bin/index.mjs"
  },
  "files": [
    "bin/",
    "setup-script/",
    "lib/"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "standard-version": {
    "preset": "angular",
    "commitAll": true
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "keywords": [
    "eslint",
    "prettier",
    "husky",
    "lint-staged",
    "commitlint",
    "commitizen"
  ],
  "author": "jett191",
  "license": "MIT",
  "dependencies": {
    "@typescript-eslint/parser": "^8.12.2",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "prettier": "^3.3.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "commitlint-config-cz": "^0.13.3",
    "cz-custom": "^0.0.2",
    "cz-customizable": "^7.2.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "chalk": "^5.3.0",
    "commitizen": "4.2.4",
    "commitlint-config-cz": "^0.13.3",
    "cz-custom": "^0.0.2",
    "cz-customizable": "^7.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "inquirer": "^12.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "shelljs": "^0.8.5",
    "standard-version": "^9.5.0"
  }
}
