{
  "name": "commit-pack",
  "version": "1.2.12",
  "description": "A lightweight initializer for code quality and commit conventions",
  "repository": {
    "type": "git",
    "url": "https://github.com/jett191/commit-pack.git"
  },
  "main": "lib/index.mjs",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --config .prettierrc '.' --write",
    "test": "node --test test/*.test.mjs",
    "prepare": "husky",
    "commit": "cz",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "release": "HUSKY=0 standard-version"
  },
  "bin": {
    "commit-pack-init": "bin/index.mjs"
  },
  "files": [
    "bin/",
    "setup-script/",
    "lib/"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "standard-version": {
    "preset": "angular",
    "commitAll": true
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "keywords": [
    "eslint",
    "prettier",
    "husky",
    "lint-staged",
    "commitlint",
    "commitizen"
  ],
  "author": "jett191",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.12.2",
    "typescript": "^5.6.3",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.2.1",
    "standard-version": "^9.5.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
