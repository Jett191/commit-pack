#!/bin/sh
_entire_stdin="$(mktemp "${TMPDIR:-/tmp}/entire-post-rewrite.XXXXXX")"
cat > "$_entire_stdin"
trap 'rm -f "$_entire_stdin"' EXIT
# Entire CLI hooks
# Post-rewrite hook: remap session linkage after amend/rebase rewrites
if command -v entire >/dev/null 2>&1; then entire hooks git post-rewrite "$1" < "$_entire_stdin" 2>/dev/null || true; else :; fi

# Chain: run pre-existing hook
_entire_hook_dir="$(dirname "$0")"
if [ -z "${ENTIRE_CHAINING_POST_REWRITE:-}" ]; then
    ENTIRE_CHAINING_POST_REWRITE=1
    export ENTIRE_CHAINING_POST_REWRITE
    if [ -n "${PRE_COMMIT_RUNNING_LEGACY:-}" ] && grep -q '^# File generated by pre-commit: https://pre-commit.com' "$_entire_hook_dir/post-rewrite.pre-entire" 2>/dev/null; then
        if [ -x "$_entire_hook_dir/post-rewrite.legacy.pre-entire" ]; then
            "$_entire_hook_dir/post-rewrite.legacy.pre-entire" "$@" < "$_entire_stdin"
        fi
    elif [ -x "$_entire_hook_dir/post-rewrite.pre-entire" ]; then
        "$_entire_hook_dir/post-rewrite.pre-entire" "$@" < "$_entire_stdin"
    fi
fi
